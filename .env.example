# MongoDB Atlas: use a database user with access only to the Neatwork database.
MONGODB_URI=
MONGODB_DB=neatwork
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Public HTTPS origin of this app (Stripe and approval links use it).
PUBLIC_BASE_URL=http://localhost:4173

# Gmail SMTP: use a Google App Password, never your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Twilio: use an SMS-enabled sender and E.164 customer phone numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Stripe card checkout; start with test-mode keys and switch to live only after testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack hosted checkout (currently supported for NGN invoices).
PAYSTACK_SECRET_KEY=

# PayPal hosted checkout. Use sandbox credentials until tested end to end.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

HOST=127.0.0.1
PORT=4173
